build/
# Out-of-tree build trees: the UI configuration keeps its own, because it pulls
# SDL3 and Dear ImGui into _deps and the default build must stay free of them.
build-*/
out/
.cache/
compile_commands.json

# Runtime state, not source: written by --midi-learn and by the analysis pass.
config/mapping.json
*.svcache
clips/
*.scratchtake

.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/

# Seeded design canvas: a ~2.5 MB generated payload that bundles the editor.
# Regenerate it from the .dc.html working files with the design skill's helper.
design/maquette-scratchvj.html
# Presets de mapping crees a l execution (specifiques a une salle)
mappings/

# Captures brutes des sondes DVS : gros, machine-specifiques, regenerables.
dvs_capture.wav

# Journal du plateau live, ecrit par scratchvj_ui quand la source est LIVE.
platter.log

# Reglages propres au bureau (entree, paire de canaux, porteuse) : jamais partages.
settings.json
